@startuml cas_utilisation
left to right direction

actor Joueur

rectangle "Démineur" {
  usecase "Choisir un niveau" as UC1
  usecase "Découvrir une case" as UC2
  usecase "Marquer / démarquer une case" as UC3
  usecase "Rejouer" as UC5
  usecase "Afficher la grille" as UC4
  usecase "Ouvrir les cases voisines\n(case sans mine autour)" as UC6
}

Joueur --> UC1
Joueur --> UC2
Joueur --> UC3
Joueur --> UC5

UC2 ..> UC4 : <<include>>
UC3 ..> UC4 : <<include>>
UC2 <.. UC6 : <<extend>>

@enduml
